# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://callflow:callflow@localhost:5432/callflow?schema=public"
# Public base URL (used for webhook signature checks and Stripe redirects)
APP_URL="http://localhost:3000"

# ─── Demo behaviour ──────────────────────────────────────────────────────────
# One-click "Sign in with demo account" on /login. Set to "false" in production.
DEMO_LOGIN_ENABLED="true"
# Password used by the demo login button (must match prisma/seed.ts)
DEMO_PASSWORD="CallFlowDemo!2026"

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Bearer token for POST /api/cron/automations. Use a long random value.
CRON_SECRET="change-me-to-a-long-random-string"

# ─── Twilio (optional — voice + SMS) ─────────────────────────────────────────
# With these set, webhook signatures are verified and the Twilio adapter is used.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Outbound SMS stays simulated unless this is explicitly "true".
SMS_LIVE_SENDING="false"
# Route webhooks for numbers not matched to an org (single-tenant deployments)
DEFAULT_ORG_SLUG="summit-peak-hvac"
# Only for local testing of Twilio routes without signatures in production builds
ALLOW_UNSIGNED_WEBHOOKS="false"

# ─── OpenAI (optional — summaries, suggested replies, KB answers) ────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ─── Google Calendar (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Short-lived OAuth access token for local testing (full OAuth flow is Phase 2)
GOOGLE_CALENDAR_ACCESS_TOKEN=""

# ─── Stripe (optional — billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""
