# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://callflow:callflow@localhost:5432/callflow?schema=public"
# Direct (non-pooled) connection used for migrations/seeding by scripts/vercel-build.mjs.
# Optional: falls back to DATABASE_URL_UNPOOLED (set by Vercel's Neon integration), then DATABASE_URL.
# DIRECT_URL=""
# Public base URL (webhook signature checks, Stripe redirects). On Vercel it defaults to the production domain.
APP_URL="http://localhost:3000"

# ─── Demo behaviour ──────────────────────────────────────────────────────────
# One-click "Sign in with demo account" on /login. Set to "false" in production.
DEMO_LOGIN_ENABLED="true"
# Password used by the demo login button (must match src/lib/demo/seed-demo.ts)
DEMO_PASSWORD="CallFlowDemo!2026"
# Public demo: shows a "Public demo" banner and enables the nightly /api/cron/reset-demo
PUBLIC_DEMO="false"
# Deploy build loads the demo tenant unless this is "false" (set false for real customer deployments)
DEMO_SEED_ON_DEPLOY="true"

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Bearer token for POST /api/cron/automations. Use a long random value.
CRON_SECRET="change-me-to-a-long-random-string"

# ─── Twilio (optional — voice + SMS) ─────────────────────────────────────────
# With these set, webhook signatures are verified and the Twilio adapter is used.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Outbound SMS stays simulated unless this is explicitly "true".
SMS_LIVE_SENDING="false"
# Route webhooks for numbers not matched to an org (single-tenant deployments)
DEFAULT_ORG_SLUG="summit-peak-hvac"
# Only for local testing of Twilio routes without signatures in production builds
ALLOW_UNSIGNED_WEBHOOKS="false"

# ─── OpenAI (optional — summaries, suggested replies, KB answers) ────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ─── Google Calendar (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Short-lived OAuth access token for local testing (full OAuth flow is Phase 2)
GOOGLE_CALENDAR_ACCESS_TOKEN=""

# ─── Stripe (optional — billing) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_PRO=""

# ─── Marketing pages (/ and /one-pager) — all optional ──────────────────────
FOUNDER_NAME=""
CONTACT_EMAIL=""
CONTACT_PHONE=""
# e.g. a free Calendly link; the "Book a demo" buttons use it (falls back to CONTACT_EMAIL, then /login)
BOOKING_URL=""
PILOT_OFFER="Free 30-day pilot for Utah HVAC companies — we set everything up for you."
SERVICE_REGION="Utah"

# ─── Real deployments (pilot / production) ─────────────────────────────────
# First admin account + company, created on deploy if the email doesn't exist yet (never resets a password)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""      # 12+ characters
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_COMPANY_NAME=""
# Set "true" if Twilio Advanced Opt-Out sends the STOP/START/HELP replies (avoids double replies)
TWILIO_HANDLES_OPT_OUT_REPLY="false"
